# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Re-include prebuilt binaries used by Dockerfile.multi-arch
!target/**

# A local vendor directory must not reach the build context: the re-includes
# above would carry its sources without vendor/modules.txt, and the build reads
# the module cache instead.
vendor/**
